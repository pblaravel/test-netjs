# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@host.docker.internal:5672
RABBITMQ_PREFETCH=1
RABBITMQ_MAX_RETRIES=3
RABBITMQ_MANUAL_ACK=true

# Producer
PRODUCER_PORT=3001

# Telegram
TELEGRAM_PORT=3003
TELEGRAM_BOT_TOKEN=test-bot-token
TELEGRAM_CHAT_ID=123456789
# Для Docker с mock-сервисом (по умолчанию в docker-compose):
TELEGRAM_API_BASE_URL=http://host.docker.internal:8080
# Для production с реальным ботом:
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# RabbitMQ Management UI credentials (docker-compose)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
